# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Internal URL the Next.js server uses to reach the Go API (defaults to NEXT_PUBLIC_API_BASE_URL)
BACKEND_URL=http://localhost:8080

# Must match the backend's JWT_SECRET and INTERNAL_SECRET
BACKEND_JWT_SECRET=change-me-jwt-secret-32chars-min
BACKEND_INTERNAL_SECRET=change-me-internal-secret-32chars

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Email magic links via Resend
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="ModelRouter <login@modelrouter.app>"

# Paddle.js (client-side token from Paddle > Developer tools > Authentication)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
