ADDR=:8080
PUBLIC_URL=http://localhost:8080        # public API URL (used for webhooks)
WEB_URL=http://localhost:3000           # website URL (used for checkout redirects)
DATABASE_URL=postgres://modelrouter:modelrouter@localhost:5432/modelrouter?sslmode=disable
DB_MAX_CONNS=32

# Secrets (min 16 chars). JWT_SECRET and INTERNAL_SECRET must match the web app's
# BACKEND_JWT_SECRET and BACKEND_INTERNAL_SECRET.
INTERNAL_SECRET=change-me-internal-secret-32chars
JWT_SECRET=change-me-jwt-secret-32chars-min
ENCRYPTION_KEY=change-me-encryption-key-32chars

# Comma-separated emails that are always admins
ADMIN_EMAILS=you@example.com

# Creates the default upstream provider on first boot
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Paddle (international payments)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
# PADDLE_PRODUCT_ID=

# SSLCommerz (Bangladesh: bKash, Nagad, cards) — leave empty to show "coming soon"
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Tuning
# CATALOG_REFRESH=30s
# MODEL_SYNC_INTERVAL=6h
# BILLING_FLUSH_INTERVAL=1s
# MAX_BODY_BYTES=33554432
# UPSTREAM_TIMEOUT=10m
# USAGE_RETENTION_DAYS=90
# CORS_ORIGINS=*
# LOG_LEVEL=info
